#!/bin/sh
# setup — подготовить чистую машину: macOS или Linux. Windows — bin\setup.ps1.
#
# Executor of meta-vault/operations/add-engine.md и шага «первый запуск».
# Запуск из любого места:  sh bin/setup
# Что делает: проверяет git и Python 3.10+, ставит Python через Homebrew,
# если его нет; если есть движок (engine/pyproject.toml или
# engine/requirements.txt) — заводит .venv в корне и ставит зависимости;
# системные пакеты движка — engine/setup-extra.sh, если он есть;
# создаёт secrets/ (вне git); в конце — прогон bin/check.
# Повторный запуск безопасен: ставит только недостающее.
set -e
cd "$(dirname "$0")/.."
echo "setup: $(pwd)"

if ! command -v git >/dev/null 2>&1; then
  echo "нет git. macOS: xcode-select --install · Linux: пакетный менеджер"
  exit 1
fi

find_py() {
  # Сначала версионные имена: на macOS python3 часто системный 3.9,
  # а нужный 3.12 стоит рядом как python3.12.
  for c in python3.14 python3.13 python3.12 python3.11 python3.10 python3 python; do
    if command -v "$c" >/dev/null 2>&1 &&
       "$c" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)' 2>/dev/null; then
      echo "$c"; return
    fi
  done
}
PY="$(find_py)"
if [ -z "$PY" ]; then
  # Ставим, только когда подходящего Python нет совсем: brew install поверх
  # уже стоящего обновил бы его, а это не наше дело.
  if [ "$(uname)" = Darwin ] && command -v brew >/dev/null 2>&1; then
    brew install python@3.12
    PY="$(brew --prefix)/bin/python3.12"
  else
    echo "нужен Python 3.10+."
    echo "  macOS: поставить Homebrew (https://brew.sh), затем brew install python@3.12"
    echo "  Linux: python3 из пакетного менеджера"
    exit 1
  fi
fi
echo "python: $($PY --version)"

if [ -f engine/pyproject.toml ] || [ -f engine/requirements.txt ]; then
  [ -d .venv ] || "$PY" -m venv .venv
  .venv/bin/python -m pip install -q --upgrade pip
  if [ -f engine/pyproject.toml ]; then
    .venv/bin/python -m pip install -q -e engine
  else
    .venv/bin/python -m pip install -q -r engine/requirements.txt
  fi
  if [ -f engine/setup-extra.sh ]; then sh engine/setup-extra.sh; fi
  echo "движок: .venv готов"
else
  echo "движка нет — ставить нечего"
fi

mkdir -p secrets
"$PY" bin/check --quiet || echo "bin/check нашёл, что поправить — запусти без --quiet"
echo "готово"
